NODE_ENV="development"
DATABASE_URL=""
AUTH_SECRET=""
SESSION_TTL_HOURS="720"

# Two-way reply from the dashboard sends free-text WhatsApp via the platform.
# Same values as the API/worker services.
WA_PLATFORM_BASE_URL=""
WA_PLATFORM_SECRET=""
WA_PLATFORM_SEND_PATH="/api/notify/custom"

# Reading customer conversations (message text) from the platform needs a login.
WA_PLATFORM_USER_EMAIL=""
WA_PLATFORM_USER_PASSWORD=""

# Plivo provisioning ("Provision & assign" in admin) calls the API service.
API_BASE_URL="https://itsoluteapi-production.up.railway.app"

# Supabase Storage for IVR greeting audio (reuses your existing Supabase project).
# Create a PUBLIC bucket named "ivr-audio". Service role key = Supabase dashboard
# → Project Settings → API → service_role secret. Server-only; never expose it.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service-role-secret..."
